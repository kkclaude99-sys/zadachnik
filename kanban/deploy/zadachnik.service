# Служба systemd: сервер сам запускается при включении VPS и перезапускается, если упадёт.
# Копируется в /etc/systemd/system/zadachnik.service (см. README.md).
[Unit]
Description=Zadachnik kanban
After=network.target

[Service]
Type=simple
User=zadachnik
WorkingDirectory=/opt/zadachnik/kanban
EnvironmentFile=/etc/zadachnik.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
